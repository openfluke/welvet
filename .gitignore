# Ship welvet.cpp / welvet.qnn C ABI artifacts with the Go module
!native/cpp/**/*.so
!native/cpp/**/*.dylib
!native/cpp/**/*.dll
!native/cpp/**/*.a
!native/qnn/**/*.so
!native/qnn/**/*.dylib
!native/qnn/**/*.dll
!native/qnn/**/*.a
bin/
dist/
.DS_Store
.gotmp/
w2a
w2a/logs/
**/logs/
tools

# local app trees (nested / port dumps)
apps/octo
apps/flux2
apps/mosstts
apps/mosstts/_ref/
openfluke.github.io
.cache/
apps/planetbridging
# Ship the independent Apple Metal backend with the Go module
!native/metal/**/*.dylib
!native/metal/**/*.a
# Ship the independent Apple MLX backend with the Go module (macOS dylib only).
# iOS MLX is too large to ship in-module (~140MB mlx.metallib + ~11MB libmlx.a) —
# build locally via welvet.mlx/scripts/ios_install_go.sh; see native/mlx/ios_arm64/README.md
!native/mlx/**/*.dylib
!native/mlx/**/*.a
!native/mlx/**/*.metallib
native/mlx/ios_arm64/*.a
native/mlx/ios_arm64/*.metallib
native/mlx/ios_arm64/MANIFEST.txt
# Ship the independent NVIDIA CUDA backend with the Go module
!native/cuda/**/*.so
!native/cuda/**/*.dll
!native/cuda/**/*.a
# Ship the independent AMD ROCm backend with the Go module
!native/rocm/**/*.so
!native/rocm/**/*.dll
!native/rocm/**/*.a
# Ship the independent Vulkan backend with the Go module
!native/vulkan/**/*.so
!native/vulkan/**/*.dll
!native/vulkan/**/*.a
